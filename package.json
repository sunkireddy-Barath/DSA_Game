    "@types/sql.js": "^1.4.9",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.11.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
