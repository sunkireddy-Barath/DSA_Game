# Copy to a real environment (systemd EnvironmentFile, your host's secret manager, ...). Never commit real values.
# The backend reads ONLY process environment variables.

APP_ENV=prod                          # "prod" disables /api/docs and defaults COOKIE_SECURE=true
COOKIE_SECURE=true                    # must be true whenever the site is served over HTTPS
ALLOWED_ORIGINS=https://your-app.vercel.app   # comma separated; only needed if the browser talks to the API cross-origin
DATABASE_PATH=/var/lib/csquest/csquest.db     # SQLite file (back it up); use a persistent disk
TRUST_PROXY=1                         # 1 only when behind a reverse proxy you control (uses X-Forwarded-For for rate limits)

# AI tutor (optional): without a key the tutor endpoint answers 503 "not configured" and the UI says so
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# C++ sandbox (needs Docker on the API host)
SANDBOX_ENABLED=true
SANDBOX_IMAGE=gcc:13-bookworm         # docker pull gcc:13-bookworm
DOCKER_CMD=docker                     # e.g. "wsl -d Ubuntu-22.04 -e docker" when Docker runs inside WSL
MAX_CONCURRENT_RUNS=2
SESSION_DAYS=14
REGISTER_LIMIT_PER_HOUR=10            # sign-ups per client address per hour
